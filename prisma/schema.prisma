datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  createdAt DateTime @default(now())
}
