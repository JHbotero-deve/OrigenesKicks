// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- CONFIGURACIÓN DE LA TIENDA (para facturación DIAN) ---

model StoreConfig {
  id          String   @id @default(uuid())
  businessName String   @map("business_name")
  nit          String
  regime      String   @default("SIMPLIFICADO")
  address     String
  city        String
  department  String   @default("Cundinamarca")
  phone       String?
  email       String?
  logoUrl     String?  @map("logo_url")
  
  invoicePrefix String @default("FK") @map("invoice_prefix")
  dianResolution String? @map("dian_resolution")
  dianFrom       Int?    @map("dian_from")
  dianTo         Int?    @map("dian_to")
  dianDate       DateTime? @map("dian_date")
  
  defaultTaxRate Decimal @default(19.0) @map("default_tax_rate")
  lastInvoiceNumber Int @default(0) @map("last_invoice_number")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("store_configs")
}

// --- SEGURIDAD Y USUARIOS ---

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  apartados         Apartado[]
  pedidos           Pedido[]
  abonosVerificados Abono[]   @relation("VerifiedBy")

  @@map("users")
}

enum Role {
  CLIENT
  SELLER
  DELIVERY
  ADMIN
}

// --- INVENTARIO Y PRODUCTOS ---

model Product {
  id            String    @id @default(uuid())
  name          String
  description   String?
  basePrice     Decimal   @map("base_price")
  discountPrice Decimal?  @map("discount_price")
  category      String?
  active        Boolean   @default(true)
  isSpecial     Boolean   @default(false) @map("is_special")
  salesCount    Int       @default(0)     @map("sales_count")
  imageUrl      String?   @map("image_url")
  sku           String?
  taxRate       Decimal?  @map("tax_rate")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  variants    Variant[]
  @@map("products")
}

model Variant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int      @default(0)
  sku       String   @unique
  
  pedidoItems   PedidoItem[]
  apartadoItems ApartadoItem[]
  inventoryLogs InventoryLog[]
  @@map("product_variants")
}

model InventoryLog {
  id          String   @id @default(uuid())
  variantId   String   @map("variant_id")
  variant     Variant  @relation(fields: [variantId], references: [id])
  changeType  String   @map("change_type")
  quantity    Int
  reason      String
  performedBy String   @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("inventory_logs")
}

// --- SISTEMA DE PEDIDOS ---

model Pedido {
  id            String       @id @default(uuid())
  clientId      String       @map("client_id")
  client        User         @relation(fields: [clientId], references: [id])
  totalAmount   Decimal      @map("total_amount")
  status        PedidoStatus @default(RECIBIDO)
  paymentMethod String       @map("payment_method")
  notes         String?
  expiresAt     DateTime?    @map("expires_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")

  items         PedidoItem[]
  envio         Envio?
  invoice       Factura?

  @@map("orders")
}

enum PedidoStatus {
  RECIBIDO
  CONFIRMADO
  PROCESANDO
  DESPACHADO
  ENTREGADO
  RECHAZADO
  CANCELADO
}

model PedidoItem {
  id        String   @id @default(uuid())
  pedidoId  String   @map("pedido_id")
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variantId String   @map("variant_id")
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal  @map("unit_price")

  @@map("order_items")
}

model Envio {
  id              String      @id @default(uuid())
  pedidoId        String      @unique @map("pedido_id")
  pedido          Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  address         String
  city            String
  department      String?     @default("Cundinamarca")
  phone           String?
  trackingNumber  String?     @map("tracking_number")
  deliveryDate    DateTime?   @map("delivery_date")
  status          EnvioStatus @default(PENDIENTE)
  notes           String?

  @@map("shippings")
}

enum EnvioStatus {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  FALLIDO
  RETORNADO
}

// --- FACTURACIÓN ELECTRÓNICA (DIAN) ---

model Factura {
  id              String    @id @default(uuid())
  invoiceNumber   Int       @map("invoice_number")
  prefix          String
  fullNumber      String    @map("full_number")
  customerName    String    @map("customer_name")
  customerIdType  String    @map("customer_id_type")
  customerId      String    @map("customer_id")
  customerEmail   String?   @map("customer_email")
  customerPhone   String?   @map("customer_phone")
  customerAddress String?   @map("customer_address")
  subtotal        Decimal
  taxAmount       Decimal   @map("tax_amount")
  totalAmount     Decimal   @map("total_amount")
  taxDetails      String?   @map("tax_details")
  paymentMethod   String    @map("payment_method")
  paymentDueDate  DateTime? @map("payment_due_date")
  cufe            String?
  cufeQrCode      String?   @map("cufe_qr_code")
  status          FacturaStatus @default(PENDIENTE)
  pedidoId        String    @unique @map("pedido_id")
  pedido          Pedido    @relation(fields: [pedidoId], references: [id])
  issueDate       DateTime  @default(now()) @map("issue_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")
  notes           String?
  
  items           FacturaItem[]

  @@map("invoices")
}

enum FacturaStatus {
  PENDIENTE
  VALIDADA
  ENVIADA
  ACEPTADA
  RECHAZADA
  ANULADA
}

model FacturaItem {
  id            String   @id @default(uuid())
  facturaId     String   @map("factura_id")
  factura       Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productName   String   @map("product_name")
  productSku    String?  @map("product_sku")
  description   String?
  quantity      Int
  unitPrice     Decimal  @map("unit_price")
  taxRate       Decimal  @map("tax_rate")
  taxAmount     Decimal  @map("tax_amount")
  lineTotal     Decimal  @map("line_total")
  size          String?
  color         String?
  
  @@map("invoice_items")
}

// --- SISTEMA DE APARTADOS (LAYAWAY) ---

model Apartado {
  id          String         @id @default(uuid())
  clientId    String         @map("client_id")
  client      User           @relation(fields: [clientId], references: [id])
  totalAmount Decimal        @map("total_amount")
  balanceDue  Decimal        @map("balance_due")
  status      ApartadoStatus @default(PENDIENTE)
  dueDate     DateTime       @map("due_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  items       ApartadoItem[]
  abonos      Abono[]

  @@map("layaways")
}

enum ApartadoStatus {
  PENDIENTE
  COMPLETADO
  EXPIRADO
  CANCELADO
}

model ApartadoItem {
  id         String   @id @default(uuid())
  apartadoId String   @map("apartado_id")
  apartado   Apartado @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  variantId  String   @map("variant_id")
  variant    Variant  @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Decimal  @map("unit_price")

  @@map("layaway_items")
}

model Abono {
  id           String   @id @default(uuid())
  apartadoId   String   @map("apartado_id")
  apartado     Apartado @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  amount       Decimal
  paymentRef   String?  @map("payment_ref")
  verified     Boolean  @default(false)
  verifiedById String?  @map("verified_by_id")
  verifiedBy   User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("layaway_payments")
}
