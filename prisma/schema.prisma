generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  SELLER
  DELIVERY
  ADMIN
  OWNER
}

enum PedidoStatus {
  RECIBIDO
  CONFIRMADO
  PROCESANDO
  DESPACHADO
  ENTREGADO
  CANCELADO
  RECHAZADO
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  password    String
  name        String?
  role        Role           @default(CLIENT)
  workStoreId String?        @map("work_store_id")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workStore        Store?         @relation("StoreStaff", fields: [workStoreId], references: [id])
  pedidos          Pedido[]
  performedLogs    InventoryLog[]
  closedClosings   DailyClosing[]

  @@map("users")
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  price         Float
  basePrice     Float?
  discountPrice Float?
  isSpecial     Boolean   @default(false)
  stock         Int       @default(0)
  active        Boolean   @default(true)
  salesCount    Int       @default(0)
  imageUrl      String?
  model3dUrl    String?   @map("model3d_url")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variants      Variant[]

  @@map("products")
}

model Store {
  id                String         @id @default(cuid())
  name              String
  address           String?
  city              String?
  phone             String?
  invoicePrefix     String         @default("FAC")
  lastInvoiceNumber Int            @default(0)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  variants          Variant[]
  pedidos           Pedido[]
  inventoryLogs     InventoryLog[]
  dailyClosings     DailyClosing[]
  staff             User[]         @relation("StoreStaff")

  @@map("stores")
}

model Variant {
  id            String         @id @default(cuid())
  productId     String         @map("product_id")
  storeId       String         @map("store_id")
  size          String?
  sku           String?
  color         String?
  price         Float?
  stock         Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pedidoItems   PedidoItem[]
  inventoryLogs InventoryLog[]

  @@map("product_variants")
}

model Pedido {
  id            String       @id @default(cuid())
  clientId      String       @map("client_id")
  storeId       String?      @map("store_id")
  status        PedidoStatus @default(RECIBIDO)
  totalAmount   Float        @default(0)
  paymentMethod String?
  paymentProvider String?
  paymentReference String? @unique
  paymentTransactionId String?
  paymentStatus String? @default("PENDING")
  notes         String?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client        User         @relation(fields: [clientId], references: [id])
  store         Store?       @relation(fields: [storeId], references: [id])
  items         PedidoItem[]
  factura       Factura?
  envio         Envio?

  @@map("pedidos")
}

model PedidoItem {
  id        String  @id @default(cuid())
  pedidoId  String  @map("pedido_id")
  variantId String  @map("variant_id")
  quantity  Int     @default(1)
  unitPrice Float

  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id])

  @@map("pedido_items")
}

model Provider {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  createdAt     DateTime       @default(now())

  inventoryLogs InventoryLog[]

  @@map("providers")
}

model InventoryLog {
  id            String    @id @default(cuid())
  variantId     String    @map("variant_id")
  storeId       String?   @map("store_id")
  performedById String?   @map("performed_by_id")
  providerId    String?   @map("provider_id")
  quantity      Int
  impact        Float     @default(0)
  changeType    String    @default("ADJUSTMENT")
  reason        String?
  createdAt     DateTime  @default(now())

  variant       Variant   @relation(fields: [variantId], references: [id])
  store         Store?    @relation(fields: [storeId], references: [id])
  performedBy   User?     @relation(fields: [performedById], references: [id])
  provider      Provider? @relation(fields: [providerId], references: [id])

  @@map("inventory_logs")
}

model Factura {
  id            String        @id @default(cuid())
  pedidoId      String        @unique @map("pedido_id")
  prefix        String
  invoiceNumber Int
  fullNumber    String
  customerName  String
  customerEmail String?
  customerId    String
  paymentMethod String
  subtotal      Float
  taxAmount     Float
  totalAmount   Float
  issueDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())

  pedido        Pedido        @relation(fields: [pedidoId], references: [id])
  items         FacturaItem[]

  @@map("facturas")
}

model FacturaItem {
  id          String  @id @default(cuid())
  facturaId   String  @map("factura_id")
  productName String
  size        String?
  quantity    Int
  unitPrice   Float
  taxAmount   Float
  lineTotal   Float

  factura     Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("factura_items")
}

model Envio {
  id        String   @id @default(cuid())
  pedidoId  String   @unique @map("pedido_id")
  address   String?
  city      String?
  phone     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedido    Pedido   @relation(fields: [pedidoId], references: [id])

  @@map("envios")
}

model DailyClosing {
  id             String   @id @default(cuid())
  storeId        String?  @map("store_id")
  closedById     String?  @map("closed_by_id")
  date           DateTime @default(now())
  totalSales     Float
  cashAmount     Float
  transferAmount Float
  totalOrders    Int
  pendingOrders  Int      @default(0)
  observations   String?
  createdAt      DateTime @default(now())

  store          Store?   @relation(fields: [storeId], references: [id])
  closedBy       User?    @relation(fields: [closedById], references: [id])

  @@map("daily_closings")
}

model AppLicense {
  id         String    @id @default(cuid())
  licenseKey String    @unique
  ownerEmail String
  masterPin  String?
  status     String    @default("ACTIVE")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("app_licenses")
}

model Administracion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@map("administración")
}