# Variables de entorno para OrigenesKicks
# Este archivo es una plantilla. NO pongas secretos reales aquí.

NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-clave-anon-aqui"

# Solo servidor. Nunca uses NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-aqui"

# Conexión PostgreSQL usada por Prisma y la aplicación.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS?sslmode=require"

# Licencia inicial. Deben configurarse con valores reales en el entorno de producción.
APP_LICENSE_KEY="tu-license-key-real"
APP_OWNER_EMAIL="correo-del-propietario@dominio.com"
APP_MASTER_PIN="tu-pin-seguro"

NODE_ENV=development
