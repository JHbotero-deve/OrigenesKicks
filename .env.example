# Supabase URL (Pública)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
# Supabase Anon Key (Obtener de Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-clave-anon-aqui"

# Supabase Service Role Key (Project Settings -> API -> service_role)
# NUNCA la pongas con prefijo NEXT_PUBLIC_ ni la expongas al navegador.
# La usa /api/auth/register y /api/staff para crear usuarios reales.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-aqui"

# Prisma - Conexión con PGBouncer (Puerto 6543) - USAR EN NETLIFY
DATABASE_URL="postgresql://postgres.TU-PROYECTO:[TU-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma - Conexión Directa (Puerto 5432) - USAR PARA MIGRACIONES LOCALES
DIRECT_URL="postgresql://postgres.TU-PROYECTO:[TU-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Licencia interna (opcional, valores por defecto si se omiten)
APP_LICENSE_KEY="OK-2026-PRO"
APP_OWNER_EMAIL="tu-correo-de-dueno@ejemplo.com"
APP_MASTER_PIN="cambia-este-pin"

# Entorno
NODE_ENV=development
