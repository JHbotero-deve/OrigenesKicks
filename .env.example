# ============================================
# Orígenes Kicks - Configuración de Entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# NUNCA comite el archivo .env al repositorio.

# --- SERVIDOR ---
PORT=3000
NODE_ENV=development

# --- SEGURIDAD ---
# Cambia esto en producción. Mínimo 32 caracteres.
JWT_SECRET=cambiar-esta-secreto-en-produccion-min-32-chars

# --- CORS ---
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:3000

# --- BASE DE DATOS ---
DATABASE_URL=file:./dev.db

# --- FACTURACIÓN DIAN ---
# Prefijo para numeración de facturas (ej: "OK" → "OK-00001")
INVOICE_PREFIX=OK
# NIT de la empresa (para facturación)
COMPANY_NIT=1234567890
# Tasa de IVA por defecto (Colombia: 19%)
DEFAULT_TAX_RATE=19
# Resolución DIAN (si ya tienes número de resolución)
DIAN_RESOLUTION=
# Rango de numeración autorizada por la DIAN
DIAN_FROM=1
DIAN_TO=5000

# --- EMAIL (para envío de facturas) ---
# SMTP para enviar facturas al cliente
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=facturacion@origeneskicks.com
